# Postgres database (e.g. Neon – https://neon.tech). Copy both from the Neon dashboard → Connect.
# Pooled connection string (host contains "-pooler"), used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (same, without "-pooler"), used to create/update tables:
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Long random string that signs login sessions. `npm run setup` creates one for you.
AUTH_SECRET="change-me-to-a-long-random-string"
