generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A construction site / project. Everything else belongs to a site.
model Site {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  budget    Float    @default(0)
  startDate DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  workers    Worker[]
  attendance Attendance[]
  payments   LabourPayment[]
  materials  MaterialPurchase[]
  expenses   Expense[]
  investments Investment[]
  deals       Deal[]
  dealPayments DealPayment[]
  materialPayments MaterialPayment[]
}

model Worker {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  role      String   @default("Labour") // Mistri, Labour, Helper, Carpenter...
  dailyWage Float
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now())
  notes     String?

  attendance Attendance[]
  payments   LabourPayment[]
}

// One row per worker per day. status: PRESENT | HALF | ABSENT
model Attendance {
  id       Int      @id @default(autoincrement())
  siteId   Int
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId Int
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date     String   // YYYY-MM-DD
  status   String
  overtime Float    @default(0) // extra amount for the day (overtime / bonus)

  @@unique([workerId, date])
  @@index([siteId, date])
}

// type: DAILY | ADVANCE | SETTLEMENT     mode: CASH | GPAY | BANK
model LabourPayment {
  id       Int      @id @default(autoincrement())
  siteId   Int
  site     Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId Int
  worker   Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date     String
  amount   Float
  type     String   @default("DAILY")
  mode     String   @default("CASH")
  note     String?
  createdAt DateTime @default(now())

  @@index([siteId, date])
}

model MaterialPurchase {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      String
  material  String   // Sariya, Cement, Brick, Sand ...
  quantity  Float
  unit      String   // kg, ton, bag, piece, trolley ...
  rate      Float
  total     Float
  paid      Float    @default(0)
  mode      String   @default("CASH")
  supplier  String?
  billNo    String?
  note      String?
  createdAt DateTime @default(now())

  payments MaterialPayment[]

  @@index([siteId, date])
}

// Each part-payment made against a material bill
model MaterialPayment {
  id         Int      @id @default(autoincrement())
  siteId     Int
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  purchaseId Int
  purchase   MaterialPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       String
  amount     Float
  mode       String   @default("CASH")
  note       String?
  createdAt  DateTime @default(now())

  @@index([siteId, date])
}

model Expense {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      String
  category  String   // Transport, Machinery, Electricity ...
  description String
  amount    Float
  mode      String   @default("CASH")
  paidTo    String?
  createdAt DateTime @default(now())

  @@index([siteId, date])
}

// Money put INTO the project (owner capital, partner, loan)
model Investment {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      String
  source    String   // who invested
  amount    Float
  mode      String   @default("BANK")
  note      String?
  createdAt DateTime @default(now())
}

// An agreed total amount that is paid or received in parts.
// direction: PAY (we pay: contractor/theka, supplier, service) | RECEIVE (we receive: client, buyer, partner)
model Deal {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction   String   @default("PAY")
  party       String   // person / company
  title       String   // what it is for
  category    String
  totalAmount Float
  date        String   // agreement date
  note        String?
  createdAt   DateTime @default(now())

  payments DealPayment[]

  @@index([siteId])
}

// One installment. status: PAID (done) | PLANNED (due on `date`)
model DealPayment {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  dealId    Int
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  date      String
  amount    Float
  mode      String   @default("CASH")
  status    String   @default("PAID")
  note      String?
  createdAt DateTime @default(now())

  @@index([siteId, date])
}
