generator client {
  provider = "prisma-client-js"
}

// Postgres (Neon). DATABASE_URL = pooled connection used by the app,
// DATABASE_URL_UNPOOLED = direct connection used by `prisma db push`.
// These are the names the Neon <-> Vercel integration creates automatically.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A construction site / project. Everything else belongs to a site.
model Site {
  id        Int      @id @default(autoincrement())
  name      String
  location  String?
  budget    Float    @default(0)
  startDate DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())

  workers          Worker[]
  attendance       Attendance[]
  payments         LabourPayment[]
  materials        MaterialPurchase[]
  expenses         Expense[]
  investments      Investment[]
  deals            Deal[]
  dealPayments     DealPayment[]
  materialPayments MaterialPayment[]
  partners         Partner[]
  payees           Payee[]
}

// Saved UPI details of a supplier / contractor / party, matched by name (case-insensitive)
model Payee {
  id     Int     @id @default(autoincrement())
  siteId Int
  site   Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name   String
  key    String // lower-case name
  upiId  String?
  phone  String?

  @@unique([siteId, key])
}

model Worker {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  upiId     String? // for "Pay now in Google Pay"
  role      String   @default("Labour") // Mistri, Labour, Helper, Carpenter...
  dailyWage Float
  active    Boolean  @default(true)
  joinedAt  DateTime @default(now())
  notes     String?

  attendance Attendance[]
  payments   LabourPayment[]
}

// One row per worker per day. status: PRESENT | HALF | ABSENT
model Attendance {
  id       Int    @id @default(autoincrement())
  siteId   Int
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId Int
  worker   Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date     String // YYYY-MM-DD
  status   String
  overtime Float  @default(0) // extra amount for the day (overtime / bonus)

  @@unique([workerId, date])
  @@index([siteId, date])
}

// type: DAILY | ADVANCE | SETTLEMENT     mode: CASH | GPAY | BANK
model LabourPayment {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  workerId    Int
  worker      Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  date        String
  amount      Float
  type        String   @default("DAILY")
  mode        String   @default("CASH")
  note        String?
  createdAt   DateTime @default(now())
  paidById    Int?
  paidBy      Partner? @relation("LabourPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  // login user who entered this row (for audit / "entered by")
  createdById Int?
  createdBy   User?    @relation("LabourCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, date])
}

model MaterialPurchase {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date      String
  material  String // Sariya, Cement, Brick, Sand ...
  quantity  Float
  unit      String // kg, ton, bag, piece, trolley ...
  rate      Float
  total     Float
  paid      Float    @default(0)
  mode      String   @default("CASH")
  supplier  String?
  billNo    String?
  note      String?
  createdAt DateTime @default(now())

  payments MaterialPayment[]

  @@index([siteId, date])
}

// Each part-payment made against a material bill
model MaterialPayment {
  id          Int              @id @default(autoincrement())
  siteId      Int
  site        Site             @relation(fields: [siteId], references: [id], onDelete: Cascade)
  purchaseId  Int
  purchase    MaterialPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date        String
  amount      Float
  mode        String           @default("CASH")
  note        String?
  createdAt   DateTime         @default(now())
  paidById    Int?
  paidBy      Partner?         @relation("MaterialPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  // login user who entered this row (for audit / "entered by")
  createdById Int?
  createdBy   User?            @relation("MaterialCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, date])
}

model Expense {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        String
  category    String // Transport, Machinery, Electricity ...
  description String
  amount      Float
  mode        String   @default("CASH")
  paidTo      String?
  createdAt   DateTime @default(now())
  paidById    Int?
  paidBy      Partner? @relation("ExpensePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  // login user who entered this row (for audit / "entered by")
  createdById Int?
  createdBy   User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, date])
}

// Money put INTO the project (owner capital, partner, loan)
model Investment {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  date        String
  source      String // who invested (name; kept for display)
  amount      Float
  mode        String   @default("BANK")
  note        String?
  createdAt   DateTime @default(now())
  paidById    Int?
  paidBy      Partner? @relation("InvestmentBy", fields: [paidById], references: [id], onDelete: SetNull)
  // login user who entered this row (for audit / "entered by")
  createdById Int?
  createdBy   User?    @relation("InvestmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

// An agreed total amount that is paid or received in parts.
// direction: PAY (we pay: contractor/theka, supplier, service) | RECEIVE (we receive: client, buyer, partner)
model Deal {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  direction   String   @default("PAY")
  party       String // person / company
  title       String // what it is for
  category    String
  totalAmount Float
  date        String // agreement date
  note        String?
  createdAt   DateTime @default(now())

  payments DealPayment[]

  @@index([siteId])
}

// One installment. status: PAID (done) | PLANNED (due on `date`)
model DealPayment {
  id          Int      @id @default(autoincrement())
  siteId      Int
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  dealId      Int
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  date        String
  amount      Float
  mode        String   @default("CASH")
  status      String   @default("PAID")
  note        String?
  createdAt   DateTime @default(now())
  // PAY deals: partner who paid. RECEIVE deals: partner who received the money.
  paidById    Int?
  paidBy      Partner? @relation("DealPaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  // login user who entered this row (for audit / "entered by")
  createdById Int?
  createdBy   User?    @relation("DealCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([siteId, date])
}

// A partner / investor in a site (e.g. Mridul, Vinay). "Paid by" on every payment points here.
// paidById = null means the money came from the common project fund.
model Partner {
  id        Int      @id @default(autoincrement())
  siteId    Int
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  sharePct  Float    @default(0) // agreed share of the total investment, in %
  phone     String?
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  labourPayments   LabourPayment[]   @relation("LabourPaidBy")
  materialPayments MaterialPayment[] @relation("MaterialPaidBy")
  expenses         Expense[]         @relation("ExpensePaidBy")
  investments      Investment[]      @relation("InvestmentBy")
  dealPayments     DealPayment[]     @relation("DealPaidBy")

  @@index([siteId])
}

// Login accounts. role: ADMIN (manage users, sites, partners) | MEMBER (enter data)
model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  passwordHash String
  role         String   @default("MEMBER")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  partners                Partner[]
  labourPaymentsEntered   LabourPayment[]   @relation("LabourCreatedBy")
  materialPaymentsEntered MaterialPayment[] @relation("MaterialCreatedBy")
  expensesEntered         Expense[]         @relation("ExpenseCreatedBy")
  investmentsEntered      Investment[]      @relation("InvestmentCreatedBy")
  dealPaymentsEntered     DealPayment[]     @relation("DealCreatedBy")
}
